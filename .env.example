# Copy this file to .env and enter the API key and API secret of your Upstox developer app.
# Never commit .env. These are app credentials, NOT your Upstox password or PIN.
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
# Register this exact redirect URI in Upstox Developer Apps.
UPSTOX_REDIRECT_URI=http://127.0.0.1:8765/auth/upstox/callback
